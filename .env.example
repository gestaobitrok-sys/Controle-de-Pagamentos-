# Copie este arquivo para ".env" e preencha os valores antes de iniciar o servidor.

APP_PASSWORD=troque-esta-senha

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-esta-chave-secreta

# Nesse servidor já rodam: posicoes-financeiras (3000), trok-api (3001),
# auditoria-lojas (3002), folha-pagamento (3003) - use 3004 aqui.
PORT=3004

# Deixe "true" só depois que o HTTPS estiver funcionando com domínio.
COOKIE_SECURE=false
